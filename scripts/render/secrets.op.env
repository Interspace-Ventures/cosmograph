# Secret references for `op run` (scripts/render/start.sh). No values here: each line points at an
# item in the app's 1Password vault, and EXO_SECURE_VAULT picks the vault per environment
# ("Cosmograph Staging" / "Cosmograph Production"). Every item must exist in the vault before the
# first deploy (an unresolvable reference stops the boot); store an empty value for one the
# environment does not use yet. Convention: item name = env var name, field = credential.
# Non-secret config (URLs, hosts, flags, the Clerk publishable key) stays plain Render env.
DATABASE_URL="op://${EXO_SECURE_VAULT}/DATABASE_URL/credential"
CLERK_SECRET_KEY="op://${EXO_SECURE_VAULT}/CLERK_SECRET_KEY/credential"
EXO_INTAKE_SECRET="op://${EXO_SECURE_VAULT}/EXO_INTAKE_SECRET/credential"
STRIPE_SECRET_KEY="op://${EXO_SECURE_VAULT}/STRIPE_SECRET_KEY/credential"
STRIPE_WEBHOOK_SECRET="op://${EXO_SECURE_VAULT}/STRIPE_WEBHOOK_SECRET/credential"
AI_INTEGRATIONS_OPENAI_API_KEY="op://${EXO_SECURE_VAULT}/AI_INTEGRATIONS_OPENAI_API_KEY/credential"
