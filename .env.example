# Public web identity
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=

# Server-only identity and data
CLERK_SECRET_KEY=
DATABASE_URL=

# local, staging, release-candidate, or production. Production-like environments
# require Cosmograph's matching Clerk live keys.
APP_ENV=local

# Release cadence
VITE_RELEASE_CHANNEL=friends-and-family
RELEASE_CHANNEL=friends-and-family
VITE_FEATURE_FLAG_OVERRIDES=
FEATURE_FLAG_OVERRIDES=

# Private review environments only. Keep unset or false in production.
STAGING_AUTH_REQUIRED=false
STAGING_AUTHORIZED_USER_IDS=
STAGING_AUTHORIZED_ORGANIZATION_IDS=
