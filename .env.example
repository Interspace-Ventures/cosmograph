# Convex (Phase 1 of docs/convex-migration-plan.md). Set on each Convex
# deployment by Exo delivery, never in Railway/Replit/Vercel env. All three are
# PUBLIC, non-secret config: Exo ID tokens are verified against Exo's public
# JWKS, so there is no auth secret, client secret or signing key.
# Staging issuer: https://frugal-eel-930.convex.site/exo-id. Never point a
# production deployment at the staging issuer (or the reverse).
# Registered in exo#229 (merged as exo#240): redirect URIs
#   https://staging.exo.now/cosmograph/auth/callback
#   https://cosmograph.space/auth/callback
#   http://localhost:3000/cosmograph/auth/callback
# Production issuer (not live until EXO prod is promoted):
#   https://befitting-bullfrog-619.convex.site/exo-id
EXO_ID_ISSUER=
# Comma-separated audiences Convex accepts. Do not add exo-staging.
EXO_ID_AUDIENCE=cosmograph
# Exo app id the SPA uses for its PKCE hand-off; must be one of EXO_ID_AUDIENCE.
EXO_ID_CLIENT_ID=cosmograph
# Written by `npx convex dev` into .env.local; listed here for reference only.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# SPA side of Exo Key (Phase 2), used only when the build enables the
# `convex-account` release flag (VITE_FEATURE_FLAG_OVERRIDES=convex-account=on).
# Public values: the SPA reads authorize/token/revoke endpoints from
# <VITE_EXO_ID_ISSUER>/.well-known/openid-configuration and redeems the code in
# the browser (PKCE, no client secret). Redirect URI: <origin><base>/auth/callback.
VITE_EXO_ID_ISSUER=
VITE_EXO_ID_CLIENT_ID=cosmograph
# Convex HTTP actions host (billing). Defaults to VITE_CONVEX_URL with
# .convex.cloud -> .convex.site.
VITE_CONVEX_SITE_URL=

# Convex billing (Phase 3). Non-secret config on each Convex deployment.
# NO Stripe secret goes in env: STRIPE_SECRET_KEY and the webhook signing
# secret are read at runtime from 1Password; billing refuses to run if either
# is set as env. The only secret is the read-only 1Password service account
# token (set by Exo, scoped to Cosmograph's vault items).
OP_SERVICE_ACCOUNT_TOKEN=
OP_VAULT=Interspace
OP_STRIPE_SECRET_KEY_ITEM=Cosmograph staging: STRIPE_SECRET_KEY
OP_STRIPE_WEBHOOK_SECRET_ITEM=Cosmograph staging: STRIPE_WEBHOOK_SECRET
# test (default) or live; the vault key's mode must match.
STRIPE_MODE=test
# Pre-existing Price ids ($9.99/year, $29.99 one-time). Never created at runtime.
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=
# Origin + return URL allowlist (defaults: cosmograph.space, app.cosmograph.space, staging.exo.now).
PUBLIC_APP_ORIGINS=
ALLOWED_ORIGINS=
CHECKOUT_PER_MINUTE=3
CHECKOUT_DAILY_PER_CLIENT=20
CHECKOUT_DAILY_GLOBAL=5000
STRIPE_AUTOMATIC_TAX=false

# Legacy Express server (removed in Phase 5)
# Staging gate: the origin accepts only requests carrying the EXO gateway's
# token for this App. Public, non-secret (the token is checked against the
# issuer's public JWKS).
STAGING_AUTH_REQUIRED=
EXO_KEY_ISSUER=

# EXO-owned server-to-server feedback boundary.
EXO_INTAKE_API_URL=
EXO_INTAKE_SECRET=

# Release cadence
VITE_RELEASE_CHANNEL=friends-and-family
RELEASE_CHANNEL=friends-and-family
VITE_FEATURE_FLAG_OVERRIDES=
FEATURE_FLAG_OVERRIDES=

# Private review environments only. Keep unset or false in production.
STAGING_AUTH_REQUIRED=false
APP_BASE_PATH=/cosmograph

# Content Security Policy (non-secret). report-only (default) | enforce | off
CSP_MODE=report-only
# Extra connect-src origins, space-separated (e.g. the Convex deployment)
# CSP_CONNECT_SRC=https://example.convex.cloud wss://example.convex.cloud
