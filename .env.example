# Identity: Exo Key (Exo ID) only. Every value here is PUBLIC, non-secret
# configuration; tokens are verified against Exo's public JWKS. There is no
# auth secret, client secret, or signing key to set.
# Browser (inlined at build time):
VITE_EXO_ID_ISSUER=https://frugal-eel-930.convex.site/exo-id
# Optional; otherwise read from Exo discovery.
VITE_EXO_ID_AUTHORIZE_URL=
# Optional Exo ID app (token audience); default cosmograph.
VITE_EXO_ID_APP=
# Server:
EXO_ID_ISSUER=https://frugal-eel-930.convex.site/exo-id
# Comma-separated audiences the API accepts; default cosmograph. Do not add
# exo-staging (the staging gateway's audience); see docs/staging.md.
EXO_ID_AUDIENCE=cosmograph

# Server-only data
DATABASE_URL=

# EXO-owned server-to-server feedback boundary.
EXO_INTAKE_API_URL=
EXO_INTAKE_SECRET=

# Release cadence
VITE_RELEASE_CHANNEL=friends-and-family
RELEASE_CHANNEL=friends-and-family
VITE_FEATURE_FLAG_OVERRIDES=
FEATURE_FLAG_OVERRIDES=

# Private review environments only. Keep unset or false in production.
STAGING_AUTH_REQUIRED=false
APP_BASE_PATH=/cosmograph
